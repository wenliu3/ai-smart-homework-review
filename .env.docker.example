# Docker 部署环境变量模板。
# 使用方法：复制为 .env.docker 并把所有占位符改成强密钥，再启动：
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
# 注意：.env.docker 含真实密钥，已被 .gitignore 忽略，切勿提交到 git。

# MySQL 数据库密码（改成你自己的强密码）
MYSQL_ROOT_PASSWORD=change_me_strong_mysql_password

# PostgreSQL Agent 状态库密码
POSTGRES_PASSWORD=change_me_strong_postgres_password

# JWT 加密密钥（改成至少 32 位的随机字符串）
JWT_SECRET=change_me_strong_jwt_secret_at_least_32_chars

# 多智能体助手总开关（可选，默认 true；false 时新版助手流式端点整体关闭）
MULTI_AGENT_ENABLED=true

# 教师白名单灰度（可选）：逗号分隔教师 ID；留空 = 全部教师放行
MULTI_AGENT_TEACHER_WHITELIST=

# 助手整轮运行总超时（秒，可选，默认 150）。
# 创建作业草稿等写操作需要「多次模型调用串行执行」，默认 45 秒太紧；
# 批改任务走独立的 120 秒预算，不受本值影响。
AGENT_RUN_TIMEOUT_SECONDS=150
