# ===== 数据库配置 =====
# MySQL 连接字符串格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/ai_smart_review?charset=utf8mb4
ASSISTANT_DATABASE_URL=postgresql://langgraph_user:123456@localhost:5432/ai_smart_review?sslmode=disable

# ===== JWT 配置 =====
JWT_SECRET=ai-smart-review-secret-key-2026
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# ===== 服务配置 =====
PORT=83
DEFAULT_PASSWORD=123456789
UPLOAD_DIR=uploads

# ===== 多智能体助手（规划 5.6）=====
# 总开关：false 时新版 /assistant/runs/stream 整体关闭
MULTI_AGENT_ENABLED=true
# 教师白名单灰度：逗号分隔教师 ID；留空 = 全部教师放行（学生/管理员不受影响）
MULTI_AGENT_TEACHER_WHITELIST=
